{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "curl -fsSL https://astral.sh/uv/0.11.7/install.sh -o /tmp/slash-install-uv.sh && UV_UNMANAGED_INSTALL=/tmp/slash-uv sh /tmp/slash-install-uv.sh",
  "buildCommand": "/tmp/slash-uv/uv run --python 3.12 --script splashwallet-homepage-capture/build_pages.py public --base-path '' --origin https://slashtra.de",
